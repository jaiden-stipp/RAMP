{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ramp.local/schemas/0.1.0/project.schema.json",
  "title": "RAMP project 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "project", "agents"],
  "properties": {
    "protocolVersion": { "const": "0.1.0" },
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "question", "scope", "exclusions", "allowedCapabilities", "limits", "stopConditions"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/text" },
        "question": { "$ref": "#/definitions/text" },
        "scope": { "type": "array", "$ref": "#/definitions/texts", "minItems": 1 },
        "exclusions": { "$ref": "#/definitions/texts" },
        "allowedCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$" } },
        "limits": {
          "type": "object", "additionalProperties": false, "required": ["maxSources", "maxIterations"],
          "properties": { "maxSources": { "$ref": "#/definitions/budget" }, "maxIterations": { "$ref": "#/definitions/budget" } }
        },
        "stopConditions": { "type": "array", "$ref": "#/definitions/texts", "minItems": 1 }
      }
    },
    "agents": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "modules"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "modules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^(roles|methods|personas|outputs)/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" } }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "pattern": "\\S" },
    "texts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/text" } },
    "budget": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
  }
}
