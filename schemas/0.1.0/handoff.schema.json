{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "https://ramp.local/schemas/0.1.0/handoff.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["artifactVersion", "id", "projectId", "taskId", "task", "fromAgent", "toAgent", "sourceLock", "destinationLock", "previousModules", "nextModules", "completedWork", "openQuestions", "nextAction", "conclusion", "uncertainty", "budgetUsage", "evidenceFile", "evidenceHash", "evidence", "evidenceIds", "artifacts", "sameUnderlyingAgent"],
  "properties": {
    "artifactVersion": { "const": "0.1.0" }, "id": { "$ref": "#/definitions/text" }, "projectId": { "$ref": "#/definitions/text" }, "taskId": { "$ref": "#/definitions/text" },
    "task": { "type": "object" }, "fromAgent": { "$ref": "#/definitions/text" }, "toAgent": { "$ref": "#/definitions/text" },
    "sourceLock": { "type": "object" }, "destinationLock": { "type": "object" },
    "previousModules": { "$ref": "#/definitions/texts" }, "nextModules": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } },
    "completedWork": { "$ref": "#/definitions/texts" }, "openQuestions": { "$ref": "#/definitions/texts" },
    "nextAction": { "$ref": "#/definitions/text" }, "conclusion": { "$ref": "#/definitions/text" }, "uncertainty": { "$ref": "#/definitions/text" },
    "budgetUsage": { "type": "object", "additionalProperties": false, "required": ["sources", "iterations"], "properties": { "sources": { "type": "integer", "minimum": 0 }, "iterations": { "type": "integer", "minimum": 0 } } },
    "evidenceFile": { "$ref": "#/definitions/text" }, "evidenceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "evidence": { "type": "object" },
    "evidenceIds": { "$ref": "#/definitions/texts" }, "artifacts": { "type": "array", "items": { "type": "object" } }, "sameUnderlyingAgent": { "type": "boolean" }
  },
  "definitions": { "text": { "type": "string", "pattern": "\\S" }, "texts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/text" } } }
}
