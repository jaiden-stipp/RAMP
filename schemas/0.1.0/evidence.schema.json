{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ramp.local/schemas/0.1.0/evidence.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["artifactVersion", "projectId", "synthetic", "evidence", "claims"],
  "properties": {
    "artifactVersion": { "const": "0.1.0" }, "projectId": { "$ref": "#/definitions/id" }, "synthetic": { "type": "boolean" },
    "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidence" } },
    "claims": { "type": "array", "items": { "$ref": "#/definitions/claim" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
    "text": { "type": "string", "pattern": "\\S" },
    "unknownText": { "anyOf": [{ "$ref": "#/definitions/text" }, { "type": "null" }] },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "texts": { "type": "array", "items": { "$ref": "#/definitions/text" } },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "title", "author", "publisher", "published", "accessed", "location", "supportedClaims", "limitations", "status", "contradicts"],
      "properties": {
        "id": { "$ref": "#/definitions/id" }, "source": { "$ref": "#/definitions/text" },
        "title": { "$ref": "#/definitions/unknownText" }, "author": { "$ref": "#/definitions/unknownText" }, "publisher": { "$ref": "#/definitions/unknownText" },
        "published": { "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }] },
        "accessed": { "type": "string", "format": "date" }, "location": { "$ref": "#/definitions/unknownText" },
        "supportedClaims": { "$ref": "#/definitions/ids" }, "limitations": { "$ref": "#/definitions/texts" },
        "status": { "enum": ["accessible", "inaccessible"] }, "contradicts": { "$ref": "#/definitions/ids" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "accessible" } } }, "then": { "properties": { "location": { "type": "string", "pattern": "\\S" } } } },
        { "if": { "properties": { "status": { "const": "inaccessible" } } }, "then": { "properties": { "limitations": { "type": "array", "minItems": 1 } } } }
      ]
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "type", "status", "evidenceIds", "dependsOn", "contraryEvidenceIds", "reasoning", "uncertainty"],
      "properties": {
        "id": { "$ref": "#/definitions/id" }, "text": { "$ref": "#/definitions/text" },
        "type": { "enum": ["observation", "quotation", "inference", "hypothesis"] }, "status": { "enum": ["verified", "unverified"] },
        "evidenceIds": { "$ref": "#/definitions/ids" }, "dependsOn": { "$ref": "#/definitions/ids" }, "contraryEvidenceIds": { "$ref": "#/definitions/ids" },
        "reasoning": { "$ref": "#/definitions/unknownText" }, "uncertainty": { "$ref": "#/definitions/text" }
      }
    }
  }
}
