{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ramp.local/schemas/0.1.0/evidence-review.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["reviewVersion", "projectId", "evidenceHash", "reviews"],
  "properties": {
    "reviewVersion": { "const": "1" }, "projectId": { "$ref": "#/definitions/text" }, "evidenceHash": { "$ref": "#/definitions/hash" },
    "reviews": { "type": "array", "items": { "$ref": "#/definitions/review" } }
  },
  "definitions": {
    "text": { "type": "string", "pattern": "\\S" }, "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "claimId", "claimHash", "assessment", "reviewer", "reviewedAt", "passages", "rationale", "uncertainty"],
      "properties": {
        "id": { "$ref": "#/definitions/text" }, "claimId": { "$ref": "#/definitions/text" }, "claimHash": { "$ref": "#/definitions/hash" },
        "assessment": { "enum": ["supported", "unsupported", "uncertain"] },
        "reviewer": { "type": "object", "additionalProperties": false, "required": ["type", "identity"], "properties": { "type": { "enum": ["human", "model", "unknown"] }, "identity": { "anyOf": [{ "$ref": "#/definitions/text" }, { "type": "null" }] } }, "allOf": [{ "if": { "properties": { "type": { "enum": ["human", "model"] } } }, "then": { "properties": { "identity": { "$ref": "#/definitions/text" } } } }] },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "passages": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["evidenceId", "location"], "properties": { "evidenceId": { "$ref": "#/definitions/text" }, "location": { "$ref": "#/definitions/text" } } } },
        "rationale": { "$ref": "#/definitions/text" }, "uncertainty": { "$ref": "#/definitions/text" }
      }
    }
  }
}
